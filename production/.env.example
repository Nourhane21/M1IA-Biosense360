# BioSense360 — Variables d'environnement
# ==========================================
# Copier ce fichier en .env et adapter les valeurs :
#   cp .env.example .env
#
# Le fichier .env ne doit PAS être commité dans Git (voir .gitignore).

# Hôte et port de l'API REST
BIOSENSE_HOST=0.0.0.0
BIOSENSE_PORT=5000

# Activer le mode debug Flask (true en développement, false en production)
BIOSENSE_DEBUG=false

# Chemin vers le modèle exporté par le notebook
BIOSENSE_MODEL_PATH=./models/modele_rf.pkl
